{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "forkProcessing": "enabled",
  "ignoreDeps": [
    "com.github.ChickenHook:RestrictionBypass"
  ],
  "mode": "full",
  "customDatasources": {
    "android-platforms": {
      "description": "Reads the Android API levels from Google's Android SDK repository manifest",
      "defaultRegistryUrlTemplate": "https://dl.google.com/android/repository/repository2-3.xml",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$distinct(releases.$match(version, /path=\"platforms;android-(\\d+)(\\.\\d+)?\"/).groups[0]).{\"version\": $}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Android compile SDK of every module",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle$/"
      ],
      "matchStrings": [
        "\\bcompileSdk = (?<currentValue>\\d+)"
      ],
      "depNameTemplate": "android-compile-sdk",
      "datasourceTemplate": "custom.android-platforms",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track the Android target SDK of the app",
      "managerFilePatterns": [
        "/(^|/)build\\.gradle$/"
      ],
      "matchStrings": [
        "\\btargetSdk = (?<currentValue>\\d+)"
      ],
      "depNameTemplate": "android-target-sdk",
      "datasourceTemplate": "custom.android-platforms",
      "versioningTemplate": "loose"
    }
  ],
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": true
  }
}
